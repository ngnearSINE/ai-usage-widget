{
  "name": "ai-usage-taskbar-widget",
  "version": "1.4.3",
  "description": "Windows desktop and taskbar widget showing remaining AI usage limits for Claude, Codex, Antigravity and Grok",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "local": "powershell -NoProfile -ExecutionPolicy Bypass -File local-build.ps1",
    "local:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File local-build.ps1 -Preview",
    "local:build": "powershell -NoProfile -ExecutionPolicy Bypass -File local-build.ps1 -BuildOnly",
    "local:package": "powershell -NoProfile -ExecutionPolicy Bypass -File local-build.ps1 -Package",
    "publish": "npm version patch -m \"v%s\" && git push --follow-tags",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File local-build.ps1 -Release",
    "build:native": "powershell -ExecutionPolicy Bypass -Command \"& 'C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe' /target:winexe /optimize+ /out:native\\TaskbarDock.exe native\\TaskbarDock.cs\"",
    "build": "npm run build:native && tsc && vite build",
    "update-app": "npm run build && powershell -ExecutionPolicy Bypass -Command \"Copy-Item -Path dist,dist-electron,native,public,package.json -Destination dist-release\\win-unpacked\\resources\\app -Recurse -Force; Copy-Item -Path native,public -Destination dist-release\\win-unpacked -Recurse -Force\"",
    "test": "tsc -p test && node --test \".test-build/test/**/*.test.js\"",
    "start": "electron dist-electron/main.js",
    "dist": "npm run build && electron-builder --win --dir",
    "dist:zip": "npm run build && electron-builder --win zip"
  },
  "keywords": [
    "ai",
    "usage",
    "taskbar",
    "widget",
    "antigravity",
    "gemini",
    "claude"
  ],
  "author": "AI Usage Widget",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.9",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
